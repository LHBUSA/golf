{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "golf-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{"pattern":"golf-api.propbetedge.ai","custom_domain":true}],
  "observability": {
    "enabled": true
  },
  "services": [
    {"binding":"INGEST","service":"golf-ingest"},
    {"binding":"NEWS","service":"golf-news"},
    {
      "binding": "AUTH",
      "service": "propbetedge-auth-magic"
    }
  ]
}
