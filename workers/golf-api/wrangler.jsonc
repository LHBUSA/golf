{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "golf-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "rules": [{"type": "Data", "globs": ["**/*.ttf"], "fallthrough": false}],
  "limits": {"cpu_ms": 30000},
  "preview_urls": false,
  "routes": [
    {
      "pattern": "golf-api.propbetedge.ai",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "INGEST",
      "service": "golf-ingest"
    },
    {
      "binding": "NEWS",
      "service": "golf-news"
    },
    {
      "binding": "AUTH",
      "service": "propbetedge-auth-magic"
    },
    {
      "binding": "MARKETS",
      "service": "propsports-markets"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PUBLIC",
      "bucket_name": "golf-public"
    },
    {
      "binding": "PICKS",
      "bucket_name": "golf-source"
    }
  ]
}
