{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "golf-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "AUTH",
      "service": "propbetedge-auth-magic"
    }
  ]
}
