{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "golf-news",
  "main": "src/index.js",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "triggers": {"crons": ["*/15 * * * *"]},
  "limits": {"cpu_ms": 120000},
  "kv_namespaces": [{"binding": "STATE", "id": "734f4f363026466da1f505da5f338dfc"}],
  "services": [{"binding": "MARKETS", "service": "propsports-markets"}],
  "r2_buckets": [
    {"binding": "PUBLIC", "bucket_name": "golf-public"},
    {"binding": "PRIVATE", "bucket_name": "golf-news-private"}
  ],
  "vars": {
    "PUBLISH_ENABLED": "true",
    "NEWS_MODE": "canary",
    "NEWS_CANARY_TYPES": "final,preview,course_intelligence",
    "NEWS_DESK_V5_TYPES": "final,preview,course_intelligence,round_recap",
    "GOLF_EDITORIAL_MODEL": "gpt-5.6-sol",
    "GOLF_OPENAI_DAILY_MAX_USD": "5",
    "GOLF_EDITORIAL_MAX_OUTPUT_TOKENS": "6000"
  }
}
