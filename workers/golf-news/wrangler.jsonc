{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "golf-news",
  "main": "src/index.js",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "PUBLIC",
      "bucket_name": "golf-public"
    }
  ],
  "vars": {
    "PUBLISH_ENABLED": "true"
  }
}
