{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "golf-ingest",
  "main": "src/index.js",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "r2_buckets": [
    {
      "binding": "RAW",
      "bucket_name": "golf-source"
    },
    {
      "binding": "PUBLIC",
      "bucket_name": "golf-public"
    }
  ],
  "services": [
    {
      "binding": "MARKETS",
      "service": "propsports-markets"
    }
  ],
  "vars": {
    "PICKS_ENABLED": "0"
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "STATE",
      "id": "734f4f363026466da1f505da5f338dfc"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "limits": {
    "cpu_ms": 300000
  }
}
