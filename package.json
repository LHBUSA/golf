{
  "name": "propbetedge-golf-intelligence",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit && node scripts/check.mjs",
    "build": "node scripts/guard-source-brand.mjs && node scripts/export-public.mjs && vite build && node scripts/prerender.mjs",
    "test": "node --test tests/*.test.mjs",
    "qa:browser": "npm run build:local && playwright test",
    "guard": "node scripts/guard.mjs && node scripts/guard-source-brand.mjs",
    "audit:sources": "node scripts/source-audit.mjs",
    "canary:sources": "node scripts/source-canary.mjs",
    "build:local": "vite build && node scripts/prerender.mjs",
    "guard:source-brand": "node scripts/guard-source-brand.mjs",
    "verify:all-access": "npm test && npm run check && npm run build:local"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/workers-types": "5.20260930.2",
    "@playwright/test": "1.63.0",
    "agent-browser": "0.38.1",
    "node-html-parser": "^9.0.4",
    "pgsql-parser": "18.2.8",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "wrangler": "4.145.0"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2"
  }
}
