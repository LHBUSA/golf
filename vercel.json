{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data: https://i.ytimg.com https://www.google-analytics.com https://*.google-analytics.com https://www.googletagmanager.com; style-src 'self'; script-src 'self' https://www.googletagmanager.com; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://www.googletagmanager.com; frame-src https://www.youtube-nocookie.com; object-src 'none'; frame-ancestors 'none'; base-uri 'self'"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "rewrites": [
    {"source": "/news", "destination": "https://golf-api.propbetedge.ai/render/news"},
    {"source": "/news/:slug", "destination": "https://golf-api.propbetedge.ai/render/news/:slug"},
    {"source": "/feed.xml", "destination": "https://golf-api.propbetedge.ai/feed.xml"},
    {"source": "/news-sitemap.xml", "destination": "https://golf-api.propbetedge.ai/news-sitemap.xml"},
    {"source": "/sitemaps/news.xml", "destination": "https://golf-api.propbetedge.ai/sitemaps/news.xml"},
    {"source": "/og/:kind/:file", "destination": "https://golf-api.propbetedge.ai/og/:kind/:file"},
    {
      "source": "/api/:path*",
      "destination": "https://golf-api.propbetedge.ai/:path*"
    },
    {
      "source": "/matchups/:a/:b",
      "destination": "/matchup-view"
    }
  ]
}
